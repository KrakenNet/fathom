{
  "name": "@fathom-rules/sdk",
  "version": "0.12.0",
  "description": "TypeScript SDK for the Fathom policy engine REST API",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "docs": "typedoc --plugin typedoc-plugin-markdown --readme none --hideBreadcrumbs --gitRevision master --out ../../docs/reference/typescript-sdk src/index.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@types/node": "^26.4.1",
    "typedoc": "~0.28.20",
    "typedoc-plugin-markdown": "~4.13.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.63.1"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KrakenNet/fathom.git",
    "directory": "packages/fathom-ts"
  },
  "pnpm": {
    "overrides": {
      "vite": ">=6.4.3 <7",
      "postcss": ">=8.5.23",
      "js-yaml": ">=4.3.1 <5",
      "brace-expansion": ">=5.0.7",
      "linkify-it": ">=5.0.2 <6"
    }
  }
}
