{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "python",
  "include-v-in-tag": true,
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "skip-changelog": true,
  "packages": {
    ".": {
      "package-name": "fathom-rules",
      "extra-files": [
        {
          "type": "generic",
          "path": "src/fathom/__init__.py"
        },
        {
          "type": "json",
          "path": "packages/fathom-ts/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "generic",
          "path": "README.md"
        },
        {
          "type": "generic",
          "path": "docs/index.md"
        }
      ]
    }
  }
}
