              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "rule_trace": {
            "items": {
              "type": "string"
            },
            "title": "Rule Trace",
            "type": "array"
          }
        },
        "required": [
          "decision",
          "reason",
          "rule_trace",
          "module_trace",
          "duration_us"
